diff --git a/sycl/tools/rapl_power.py b/sycl/tools/rapl_power.py
new file mode 100755
index 0000000..c224b90
--- /dev/null
+++ b/sycl/tools/rapl_power.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""sycl/tools/rapl_power.py - publishes the CPU + iGPU package power for the Monitor tab, so the raw counter stays root-only.
+
+The kernel makes /sys/class/powercap/intel-rapl:0/energy_uj readable by root only (it is a power side channel: PLATYPUS,
+CVE-2020-8694).  An integrated GPU has no power sensor of its own, so its Monitor card needs the package figure.  This
+small service reads the counter as root once a second and writes only the average watts, to a file anyone may read:
+
+    /run/strata/power.json   {"ts": <unix time>, "power_w": <watts>, "source": "rapl-package"}
+
+sycl/serve/xe_telemetry.py reads that file when it cannot read the counter itself.  A one-second average gives nothing
+the fine-grained counter would: nobody can time individual instructions from it.
+
+Install (as root; a root-owned copy, never a script in a user's home):
+    sudo install -m 755 sycl/tools/rapl_power.py /usr/local/sbin/strata-rapl-power
+    sudo install -m 644 sycl/tools/strata-rapl-power.service /etc/systemd/system/
+    sudo systemctl daemon-reload && sudo systemctl enable --now strata-rapl-power
+Remove:  sudo systemctl disable --now strata-rapl-power && sudo rm /etc/systemd/system/strata-rapl-power.service /usr/local/sbin/strata-rapl-power
+
+  --once   one reading over one second, printed (for a check; needs read access to the counter)
+Environment (for tests): RAPL_ENERGY, RAPL_OUT
+"""
+import json
+import os
+import sys
+import time
+
+ENERGY = os.environ.get("RAPL_ENERGY", "/sys/class/powercap/intel-rapl:0/energy_uj")
+OUT = os.environ.get("RAPL_OUT", "/run/strata/power.json")
+
+
+def read_int(path):
+    try:
+        with open(path) as f:
+            return int(f.read().strip())
+    except (OSError, ValueError):
+        return None
+
+
+def watts(prev, now, wrap):
+    """Average watts between two counter readings (microjoules); None when the counter cannot be compared."""
+    (e0, t0), (e1, t1) = prev, now
+    if t1 <= t0:
+        return None
+    if e1 < e0:                       # the counter wrapped around its range
+        if not wrap:
+            return None
+        e1 += wrap
+    return (e1 - e0) / 1e6 / (t1 - t0)
+
+
+def publish(value):
+    os.makedirs(os.path.dirname(OUT), exist_ok=True)
+    tmp = OUT + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump({"ts": time.time(), "power_w": round(value, 2), "source": "rapl-package"}, f)
+    os.chmod(tmp, 0o644)
+    os.replace(tmp, OUT)              # a reader never sees half a file
+
+
+def main(argv):
+    once = "--once" in argv
+    wrap = read_int(os.path.join(os.path.dirname(ENERGY), "max_energy_range_uj")) or 0
+    prev = None
+    while True:
+        e = read_int(ENERGY)
+        if e is None:
+            sys.exit(f"cannot read {ENERGY}: run as root, or check that this CPU has RAPL")
+        cur = (e, time.monotonic())
+        if prev is not None:
+            w = watts(prev, cur, wrap)
+            if w is not None:
+                if once:
+                    print(f"{w:.2f} W")
+                    return 0
+                publish(w)
+        prev = cur
+        time.sleep(1.0)
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/sycl/tools/strata-rapl-power.service b/sycl/tools/strata-rapl-power.service
new file mode 100644
index 0000000..d6b8ecd
--- /dev/null
+++ b/sycl/tools/strata-rapl-power.service
@@ -0,0 +1,27 @@
+# Publishes the CPU + iGPU package power (watts) for the Strata Monitor tab; see sycl/tools/rapl_power.py.
+# Install: sudo install -m 755 sycl/tools/rapl_power.py /usr/local/sbin/strata-rapl-power
+#          sudo install -m 644 sycl/tools/strata-rapl-power.service /etc/systemd/system/
+#          sudo systemctl daemon-reload && sudo systemctl enable --now strata-rapl-power
+[Unit]
+Description=Package power for the Strata monitor (reads RAPL as root, publishes watts)
+
+[Service]
+ExecStart=/usr/bin/python3 /usr/local/sbin/strata-rapl-power
+RuntimeDirectory=strata
+RuntimeDirectoryMode=0755
+Restart=on-failure
+RestartSec=5
+# it only reads one sysfs file and writes one file under /run/strata: nothing else
+NoNewPrivileges=yes
+ProtectSystem=strict
+ProtectHome=yes
+PrivateTmp=yes
+PrivateNetwork=yes
+PrivateDevices=yes
+CapabilityBoundingSet=
+RestrictAddressFamilies=AF_UNIX
+MemoryDenyWriteExecute=yes
+LockPersonality=yes
+
+[Install]
+WantedBy=multi-user.target
